# Copy to config/official_baselines.local.env and fill values locally.
# Do not commit real keys.

# Shared OpenAI-compatible settings.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_BASE_URL=

# ToolEmu official runner.
# For OpenAI official API, use gpt-4 or gpt-3.5.
# For OpenAI-compatible providers, set WAMI_ALLOW_CUSTOM_OPENAI_MODEL=1
# and set TOOL_EMU_AGENT_MODEL / TOOL_EMU_EVALUATOR_MODEL to the provider model name.
WAMI_ALLOW_CUSTOM_OPENAI_MODEL=1
TOOL_EMU_AGENT_MODEL=
TOOL_EMU_EVALUATOR_MODEL=
TOOL_EMU_TRUNC_NUM=3
TOOL_EMU_BATCH_SIZE=1

# Erase-and-Check official runner.
# GPT-3.5 mode uses OpenAI-compatible chat completion as the safety filter.
# DistilBERT mode needs downloaded official weights under external/certified-llm-safety/models/.
ERASE_CHECK_LLM_NAME=GPT-3.5
ERASE_CHECK_MODEL=
ERASE_CHECK_NUM_PROMPTS=20
ERASE_CHECK_MAX_ERASE=20
ERASE_CHECK_MODE=suffix
ERASE_CHECK_USE_CLASSIFIER=0
ERASE_CHECK_MODEL_WT_PATH=external/certified-llm-safety/models/distilbert_suffix.pt

# SmoothLLM official runner.
# Requires local Vicuna/Llama-2 weights and GPU.
SMOOTHLLM_TARGET_MODEL=llama2
SMOOTHLLM_LLAMA2_MODEL_PATH=
SMOOTHLLM_LLAMA2_TOKENIZER_PATH=
SMOOTHLLM_VICUNA_MODEL_PATH=
SMOOTHLLM_VICUNA_TOKENIZER_PATH=
SMOOTHLLM_ATTACK_LOGFILE=external/smooth-llm/data/GCG/llama2_behaviors.json
SMOOTHLLM_RESULTS_DIR=external/smooth-llm/results
SMOOTHLLM_NUM_COPIES=10
SMOOTHLLM_BATCH_SIZE=1
SMOOTHLLM_DEVICE=cuda:0
SMOOTHLLM_QUANTIZATION=
SMOOTHLLM_PERT_PCT=10
SMOOTHLLM_PERT_TYPE=RandomSwapPerturbation
